(rule
 (targets cxxflags.sexp clibs.sexp)
 (deps
  (:discover ../config/discover.exe))
 (action
  (run %{discover} -cxxflags cxxflags.sexp -clibs clibs.sexp)))

(library
 (name camlqt6)
 (public_name camlqt6)
 (modules core gui widgets dsl camlqt6)
 (foreign_stubs
  (language cxx)
  (names camlqt6_stubs)
  (flags
   (:include cxxflags.sexp)))
 (c_library_flags
  (:include clibs.sexp)))
